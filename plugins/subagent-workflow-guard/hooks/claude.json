{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"subagent-workflow-guard:session\" node \"${CLAUDE_PLUGIN_ROOT}/scripts/subagent-workflow-guard.mjs\" session claude",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"subagent-workflow-guard:prompt\" node \"${CLAUDE_PLUGIN_ROOT}/scripts/subagent-workflow-guard.mjs\" prompt claude",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|Task|spawn_agent|ApplyPatch|apply_patch|Bash|Edit|MultiEdit|NotebookEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"subagent-workflow-guard:pre\" node \"${CLAUDE_PLUGIN_ROOT}/scripts/subagent-workflow-guard.mjs\" pre claude",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent|Task|spawn_agent",
        "hooks": [
          {
            "type": "command",
            "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"subagent-workflow-guard:post\" node \"${CLAUDE_PLUGIN_ROOT}/scripts/subagent-workflow-guard.mjs\" post claude",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Agent|Task|spawn_agent",
        "hooks": [
          {
            "type": "command",
            "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"subagent-workflow-guard:failure\" node \"${CLAUDE_PLUGIN_ROOT}/scripts/subagent-workflow-guard.mjs\" failure claude",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"subagent-workflow-guard:start\" node \"${CLAUDE_PLUGIN_ROOT}/scripts/subagent-workflow-guard.mjs\" start claude",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"subagent-workflow-guard:subagent-stop\" node \"${CLAUDE_PLUGIN_ROOT}/scripts/subagent-workflow-guard.mjs\" subagent-stop claude",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"subagent-workflow-guard:stop\" node \"${CLAUDE_PLUGIN_ROOT}/scripts/subagent-workflow-guard.mjs\" stop claude",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
