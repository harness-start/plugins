{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"subagent-workflow-guard:session\" node \"${PLUGIN_ROOT}/scripts/subagent-workflow-guard.mjs\" session codex",
            "statusMessage": "Loading subagent workflow contract",
            "timeout": 5000,
            "additionalContextLimit": 2000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"subagent-workflow-guard:prompt\" node \"${PLUGIN_ROOT}/scripts/subagent-workflow-guard.mjs\" prompt codex",
            "statusMessage": "Updating subagent workflow state",
            "timeout": 5000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|Task|spawn_agent|ApplyPatch|apply_patch|Bash|bash|Edit|exec|exec_command|local_shell|MultiEdit|NotebookEdit|Shell|shell|shell_command|Write|create_file|search_replace",
        "hooks": [
          {
            "type": "command",
            "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"subagent-workflow-guard:pre\" node \"${PLUGIN_ROOT}/scripts/subagent-workflow-guard.mjs\" pre codex",
            "statusMessage": "Checking subagent application",
            "timeout": 10000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent|Task|spawn_agent",
        "hooks": [
          {
            "type": "command",
            "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"subagent-workflow-guard:post\" node \"${PLUGIN_ROOT}/scripts/subagent-workflow-guard.mjs\" post codex",
            "statusMessage": "Receiving subagent result",
            "timeout": 10000,
            "additionalContextLimit": 2000
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"subagent-workflow-guard:start\" node \"${PLUGIN_ROOT}/scripts/subagent-workflow-guard.mjs\" start codex",
            "statusMessage": "Binding subagent application",
            "timeout": 10000,
            "additionalContextLimit": 4000
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"subagent-workflow-guard:subagent-stop\" node \"${PLUGIN_ROOT}/scripts/subagent-workflow-guard.mjs\" subagent-stop codex",
            "statusMessage": "Validating subagent result card",
            "timeout": 10000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"subagent-workflow-guard:stop\" node \"${PLUGIN_ROOT}/scripts/subagent-workflow-guard.mjs\" stop codex",
            "statusMessage": "Checking subagent workflow closure",
            "timeout": 10000
          }
        ]
      }
    ]
  }
}
