{
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/python-hook-context.mjs\" SessionStart", "statusMessage": "python-runtime-guards: lint coverage", "timeout": 10000 }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/python-hook-context.mjs\" UserPromptSubmit", "statusMessage": "python-runtime-guards: project environment", "timeout": 10000 }] }],
    "PreToolUse": [
      {
        "matcher": "apply_patch|ApplyPatch|Bash|bash|Edit|exec|exec_command|local_shell|MultiEdit|NotebookEdit|Shell|shell|shell_command|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/python-hook-pre-tool.mjs\"",
            "statusMessage": "python-runtime-guards: lockfile policy",
            "timeout": 15000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|ApplyPatch|Bash|bash|Edit|exec|exec_command|local_shell|MultiEdit|NotebookEdit|Shell|shell|shell_command|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/python-hook-post-tool.mjs\"",
            "statusMessage": "python-runtime-guards: encoding, debt, syntax",
            "timeout": 30000
          }
        ]
      }
    ]
  }
}
