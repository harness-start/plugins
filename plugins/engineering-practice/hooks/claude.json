{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/hooks/engineering-practice.mjs\" session-start",
            "statusMessage": "Loading engineering outcome guidance",
            "timeout": 10000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/hooks/engineering-practice.mjs\" user-prompt",
            "statusMessage": "Selecting an engineering challenge",
            "timeout": 10000
          }
        ]
      }
    ]
  }
}
