{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "apply_patch|ApplyPatch|Bash|bash|Edit|exec|exec_command|local_shell|MultiEdit|NotebookEdit|Shell|shell|shell_command|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/markdown-format-guard.mjs\"",
            "statusMessage": "Checking Markdown format",
            "timeout": 10000
          }
        ]
      }
    ]
  }
}
