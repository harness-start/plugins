{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"work-report-insights:session\" node \"${PLUGIN_ROOT}/dist/hooks/work-report-insights-hook.mjs\" session",
            "statusMessage": "Checking unfinished work report workflow",
            "timeout": 10000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"work-report-insights:prompt\" node \"${PLUGIN_ROOT}/dist/hooks/work-report-insights-hook.mjs\" prompt",
            "statusMessage": "Routing work report intent",
            "timeout": 10000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "apply_patch|ApplyPatch|Bash|bash|Edit|exec|exec_command|local_shell|MultiEdit|NotebookEdit|Shell|shell|shell_command|Write|create_file|search_replace",
        "hooks": [
          {
            "type": "command",
            "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"work-report-insights:pre\" node \"${PLUGIN_ROOT}/dist/hooks/work-report-insights-hook.mjs\" pre",
            "statusMessage": "Protecting confirmed work reports",
            "timeout": 10000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|bash|exec|exec_command|local_shell|Shell|shell|shell_command",
        "hooks": [
          {
            "type": "command",
            "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"work-report-insights:post\" node \"${PLUGIN_ROOT}/dist/hooks/work-report-insights-hook.mjs\" post",
            "statusMessage": "Verifying work report receipt",
            "timeout": 10000
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash|bash|exec|exec_command|local_shell|Shell|shell|shell_command",
        "hooks": [
          {
            "type": "command",
            "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"work-report-insights:failure\" node \"${PLUGIN_ROOT}/dist/hooks/work-report-insights-hook.mjs\" failure",
            "statusMessage": "Recording work report failure",
            "timeout": 10000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"work-report-insights:stop\" node \"${PLUGIN_ROOT}/dist/hooks/work-report-insights-hook.mjs\" stop",
            "statusMessage": "Checking work report closure",
            "timeout": 10000
          }
        ]
      }
    ]
  }
}
