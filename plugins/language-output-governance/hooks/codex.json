{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/language-output-hook-session-start.mjs\"",
            "statusMessage": "Language Output: loading session profile",
            "timeout": 10000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/language-output-hook-user-prompt.mjs\"",
            "statusMessage": "Language Output: recording language intent",
            "timeout": 10000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/language-output-hook-post-tool.mjs\"",
            "statusMessage": "Language Output: checking generated text",
            "timeout": 10000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/language-output-hook-stop.mjs\"",
            "statusMessage": "Language Output: checking final response",
            "timeout": 10000
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/language-output-hook-stop.mjs\"",
            "statusMessage": "Language Output: checking subagent response",
            "timeout": 10000
          }
        ]
      }
    ]
  }
}
