        "hooks": [
          {
            "type": "command",
            "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"print-publication-delivery-guard:subagent-stop\" node \"${PLUGIN_ROOT}/dist/hooks/print-publication-delivery-guard.mjs\" stop",
            "statusMessage": "Validating Print artifact closure",
            "timeout": 10000
