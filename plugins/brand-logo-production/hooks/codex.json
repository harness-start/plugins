{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "HARNESS_HOST=codex AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"brand-logo-production:session\" node \"${PLUGIN_ROOT}/dist/hooks/brand-logo-production.mjs\" session",
            "statusMessage": "Discovering Logo artifact projects",
            "timeout": 10000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "apply_patch|ApplyPatch|Bash|bash|Edit|exec|exec_command|local_shell|MultiEdit|NotebookEdit|Shell|shell|shell_command|Write|create_file|search_replace",
        "hooks": [
          {
            "type": "command",
            "command": "HARNESS_HOST=codex AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"brand-logo-production:pre\" node \"${PLUGIN_ROOT}/dist/hooks/brand-logo-production.mjs\" pre",
            "statusMessage": "Checking Logo artifact writer boundaries",
            "timeout": 10000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|ApplyPatch|Bash|bash|Edit|exec|exec_command|local_shell|MultiEdit|NotebookEdit|Shell|shell|shell_command|Write|create_file|search_replace",
        "hooks": [
          {
            "type": "command",
            "command": "HARNESS_HOST=codex AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"brand-logo-production:post\" node \"${PLUGIN_ROOT}/dist/hooks/brand-logo-production.mjs\" post",
            "statusMessage": "Revalidating Logo artifact evidence",
            "timeout": 10000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "HARNESS_HOST=codex AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"brand-logo-production:stop\" node \"${PLUGIN_ROOT}/dist/hooks/brand-logo-production.mjs\" stop",
            "statusMessage": "Validating Logo artifact closure",
            "timeout": 10000
          }
        ]
      }
    ]
  }
}
