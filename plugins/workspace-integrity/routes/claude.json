      "handler": "commands:cmd-safety-hook-pre-tool"
    },
    {
      "args": ["pre"],
      "timeoutMs": 10000,
      "trigger": "source-integrity:pre",
      "matcher": "apply_patch|ApplyPatch|Bash|bash|Edit|exec|exec_command|local_shell|MultiEdit|NotebookEdit|Shell|shell|shell_command|Write|create_file|search_replace",
      "handler": "source:source-integrity"
    },
    {
      "timeoutMs": 60000,
      "trigger": "domain-engineering:pre",
      "matcher": "apply_patch|ApplyPatch|Bash|bash|Edit|exec|exec_command|local_shell|MultiEdit|NotebookEdit|Shell|shell|shell_command|Write|create_file|search_replace",
      "handler": "domains:pre-tool"
    }
  ],
  "PostToolUse": [
    {
      "timeoutMs": 60000,
      "trigger": "domain-engineering:post",
      "matcher": "apply_patch|ApplyPatch|Bash|bash|Edit|exec|exec_command|local_shell|MultiEdit|NotebookEdit|Shell|shell|shell_command|Write|create_file|search_replace",
      "handler": "domains:post-tool"
    },
    {
      "timeoutMs": 15000,
      "trigger": "command-safety:post-tool-use",
      "matcher": "apply_patch|ApplyPatch|Bash|bash|Edit|exec|exec_command|local_shell|MultiEdit|NotebookEdit|Shell|shell|shell_command|Write",
