{
  "PreToolUse": [
    {
      "timeoutMs": 60000,
      "trigger": "engineering-quality:pre",
      "matcher": "apply_patch|ApplyPatch|Edit|MultiEdit|NotebookEdit|Write|create_file|search_replace",
      "handler": "quality:engineering-quality-pre"
    },
    {
      "timeoutMs": 15000,
      "trigger": "command-safety:pre-tool-use",
