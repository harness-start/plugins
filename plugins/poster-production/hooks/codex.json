{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"poster-production:session\" node \"${PLUGIN_ROOT}/dist/hooks/poster-production.mjs\" session",
            "statusMessage": "Discovering Poster artifact projects",
            "timeout": 10000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "apply_patch|ApplyPatch|Bash|bash|Edit|exec|exec_command|local_shell|MultiEdit|NotebookEdit|Shell|shell|shell_command|Write|create_file|search_replace",
        "hooks": [
          {
            "type": "command",
            "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"poster-production:pre\" node \"${PLUGIN_ROOT}/dist/hooks/poster-production.mjs\" pre",
            "statusMessage": "Checking Poster artifact writer boundaries",
            "timeout": 10000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|ApplyPatch|Bash|bash|Edit|exec|exec_command|local_shell|MultiEdit|NotebookEdit|Shell|shell|shell_command|Write|create_file|search_replace",
        "hooks": [
          {
            "type": "command",
            "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"poster-production:post\" node \"${PLUGIN_ROOT}/dist/hooks/poster-production.mjs\" post",
            "statusMessage": "Revalidating Poster artifact evidence",
            "timeout": 10000
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash|bash|exec|exec_command|local_shell|Shell|shell|shell_command",
        "hooks": [
          {
            "type": "command",
            "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"poster-production:failure\" node \"${PLUGIN_ROOT}/dist/hooks/poster-production.mjs\" failure",
            "statusMessage": "Checking partial Poster mutations",
            "timeout": 10000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"poster-production:stop\" node \"${PLUGIN_ROOT}/dist/hooks/poster-production.mjs\" stop",
            "statusMessage": "Validating Poster artifact closure",
            "timeout": 10000
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"poster-production:subagent-stop\" node \"${PLUGIN_ROOT}/dist/hooks/poster-production.mjs\" subagent-stop",
            "statusMessage": "Validating Poster artifact closure",
            "timeout": 10000
          }
        ]
      }
    ]
  }
}
