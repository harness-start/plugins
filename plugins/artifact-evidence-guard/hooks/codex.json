{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"artifact-evidence-guard:stop\" node \"${PLUGIN_ROOT}/scripts/artifact-evidence-guard.mjs\" stop",
            "statusMessage": "Validating explicit artifact evidence",
            "timeout": 10000
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"artifact-evidence-guard:subagent-stop\" node \"${PLUGIN_ROOT}/scripts/artifact-evidence-guard.mjs\" stop",
            "statusMessage": "Validating explicit artifact evidence",
            "timeout": 10000
          }
        ]
      }
    ]
  }
}
