{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/project-capability-governance-hook.mjs\" session claude",
            "statusMessage": "Loading project capability discovery criteria",
            "timeout": 5000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "ApplyPatch|apply_patch|Bash|bash|Edit|exec|exec_command|local_shell|MultiEdit|NotebookEdit|Shell|shell|shell_command|Write|create_file|search_replace",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PROJECT_CAPABILITY_GOVERNANCE_ROOT:-${CLAUDE_PLUGIN_ROOT}}/scripts/project-capability-governance-hook.mjs\" pre claude",
            "statusMessage": "Protecting the project capability inbox",
            "timeout": 10000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PROJECT_CAPABILITY_GOVERNANCE_ROOT:-${CLAUDE_PLUGIN_ROOT}}/scripts/project-capability-governance-hook.mjs\" stop claude",
            "statusMessage": "Checking for new human-only capability notices",
            "timeout": 10000
          }
        ]
      }
    ]
  }
}
