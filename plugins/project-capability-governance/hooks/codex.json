{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"project-capability-governance:session\" node \"${PLUGIN_ROOT}/dist/hooks/project-capability-governance-hook.mjs\" session codex",
            "statusMessage": "Loading project capability discovery criteria",
            "timeout": 5000,
            "additionalContextLimit": 2400
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "ApplyPatch|apply_patch|Bash|bash|Edit|exec|exec_command|local_shell|MultiEdit|NotebookEdit|Shell|shell|shell_command|Write|create_file|search_replace",
        "hooks": [
          {
            "type": "command",
            "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"project-capability-governance:pre\" node \"${PLUGIN_ROOT}/dist/hooks/project-capability-governance-hook.mjs\" pre codex",
            "statusMessage": "Protecting the project capability inbox",
            "timeout": 10000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"project-capability-governance:stop\" node \"${PLUGIN_ROOT}/dist/hooks/project-capability-governance-hook.mjs\" stop codex",
            "statusMessage": "Checking for new human-only capability notices",
            "timeout": 10000
          }
        ]
      }
    ]
  }
}
