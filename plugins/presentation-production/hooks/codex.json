{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"presentation-production:session\" node \"${PLUGIN_ROOT}/dist/hooks/presentation-production.mjs\" session",
            "statusMessage": "Discovering PPTX artifact projects",
            "timeout": 10000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "apply_patch|ApplyPatch|Bash|bash|Edit|exec|exec_command|local_shell|MultiEdit|NotebookEdit|Shell|shell|shell_command|Write|create_file|search_replace",
        "hooks": [
          {
            "type": "command",
            "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"presentation-production:pre\" node \"${PLUGIN_ROOT}/dist/hooks/presentation-production.mjs\" pre",
            "statusMessage": "Checking PPTX artifact writer boundaries",
            "timeout": 10000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|ApplyPatch|Bash|bash|Edit|exec|exec_command|local_shell|MultiEdit|NotebookEdit|Shell|shell|shell_command|Write|create_file|search_replace",
        "hooks": [
          {
            "type": "command",
            "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"presentation-production:post\" node \"${PLUGIN_ROOT}/dist/hooks/presentation-production.mjs\" post",
            "statusMessage": "Revalidating PPTX artifact evidence",
            "timeout": 10000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"presentation-production:stop\" node \"${PLUGIN_ROOT}/dist/hooks/presentation-production.mjs\" stop",
            "statusMessage": "Validating PPTX artifact closure",
            "timeout": 10000
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"presentation-production:subagent-stop\" node \"${PLUGIN_ROOT}/dist/hooks/presentation-production.mjs\" subagent-stop",
            "statusMessage": "Validating PPTX artifact closure",
            "timeout": 10000
          }
        ]
      }
    ]
  }
}
