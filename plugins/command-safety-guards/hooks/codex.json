{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "apply_patch|ApplyPatch|Bash|bash|Edit|exec|exec_command|local_shell|MultiEdit|NotebookEdit|Read|Shell|shell|shell_command|Write",
        "hooks": [
          {
            "type": "command",
            "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"command-safety-guards:pre-tool-use\" node \"${PLUGIN_ROOT}/dist/hooks/cmd-safety-hook-pre-tool.mjs\"",
            "statusMessage": "command-safety-guards: checking shell command",
            "timeout": 15000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|ApplyPatch|Bash|bash|Edit|exec|exec_command|local_shell|MultiEdit|NotebookEdit|Shell|shell|shell_command|Write",
        "hooks": [
          {
            "type": "command",
            "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"command-safety-guards:post-tool-use\" node \"${PLUGIN_ROOT}/dist/hooks/cmd-safety-hook-post-tool.mjs\"",
            "statusMessage": "command-safety-guards: checking written files",
            "timeout": 15000
          }
        ]
      }
    ]
  }
}
