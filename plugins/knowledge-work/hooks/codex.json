    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"knowledge-work:Stop\" node \"${PLUGIN_ROOT}/dist/hooks/dispatcher.mjs\" codex Stop",
            "statusMessage": "knowledge-work: applying always-on governance",
            "timeout": 120000
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash|bash|exec|exec_command|local_shell|Shell|shell|shell_command",
        "hooks": [
          {
            "type": "command",
            "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"knowledge-work:PostToolUseFailure\" node \"${PLUGIN_ROOT}/dist/hooks/dispatcher.mjs\" codex PostToolUseFailure",
