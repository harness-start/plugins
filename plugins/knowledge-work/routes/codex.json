{
  "SessionStart": [
    {
      "args": [
        "session"
      ],
      "timeoutMs": 10000,
      "trigger": "evidence-based-research:session",
      "handler": "research:evidence-based-research"
    },
    {
      "timeoutMs": 10000,
      "trigger": "professional-writing:session-start",
      "handler": "writing:professional-writing"
    },
    {
      "args": [
        "session"
      ],
      "timeoutMs": 10000,
      "trigger": "work-reporting:session",
      "handler": "reporting:work-reporting-hook"
    }
  ],
  "UserPromptSubmit": [
    {
      "args": [
        "prompt"
      ],
      "timeoutMs": 10000,
      "trigger": "professional-writing:prompt",
      "handler": "writing:professional-writing"
    },
    {
      "args": [
        "prompt"
      ],
      "timeoutMs": 10000,
      "trigger": "evidence-based-research:prompt",
      "handler": "research:evidence-based-research"
    },
    {
      "args": [
        "prompt"
      ],
      "timeoutMs": 10000,
      "trigger": "work-reporting:prompt",
      "handler": "reporting:work-reporting-hook"
    }
  ],
  "PreToolUse": [
    {
      "args": [
        "pre"
      ],
      "timeoutMs": 10000,
      "trigger": "evidence-based-research:pre",
      "matcher": "apply_patch|ApplyPatch|Bash|bash|Edit|exec|exec_command|local_shell|MultiEdit|NotebookEdit|Shell|shell|shell_command|Write|create_file|search_replace|mcp__.*research_provenance__.*",
      "handler": "research:evidence-based-research"
    },
    {
      "args": [
        "pre"
      ],
      "timeoutMs": 10000,
      "trigger": "work-reporting:pre",
      "matcher": "apply_patch|ApplyPatch|Bash|bash|Edit|exec|exec_command|local_shell|MultiEdit|NotebookEdit|Shell|shell|shell_command|Write|create_file|search_replace",
      "handler": "reporting:work-reporting-hook"
    }
  ],
  "PostToolUse": [
    {
      "args": [
        "post"
      ],
      "timeoutMs": 10000,
      "trigger": "evidence-based-research:post",
      "matcher": "apply_patch|ApplyPatch|Bash|bash|Edit|exec|exec_command|local_shell|MultiEdit|NotebookEdit|Shell|shell|shell_command|Write|create_file|search_replace|mcp__.*research_provenance__.*",
      "handler": "research:evidence-based-research"
    },
    {
      "args": [
        "post"
      ],
      "timeoutMs": 10000,
      "trigger": "professional-writing:post",
      "matcher": "apply_patch|ApplyPatch|Bash|bash|create_file|CreateFile|Edit|exec|exec_command|local_shell|MultiEdit|NotebookEdit|search_replace|SearchReplace|Shell|shell|shell_command|Write",
      "handler": "writing:professional-writing"
    },
    {
      "args": [
        "post"
      ],
      "timeoutMs": 10000,
      "trigger": "work-reporting:post",
      "matcher": "Bash|bash|exec|exec_command|local_shell|Shell|shell|shell_command",
      "handler": "reporting:work-reporting-hook"
    }
  ],
  "Stop": [
    {
      "args": [
        "stop"
      ],
      "timeoutMs": 10000,
      "trigger": "evidence-based-research:stop",
      "handler": "research:evidence-based-research"
    },
    {
      "args": [
        "stop"
      ],
      "timeoutMs": 10000,
      "trigger": "work-reporting:stop",
      "handler": "reporting:work-reporting-hook"
    }
  ],
  "PostToolUseFailure": [
    {
      "args": [
        "failure"
      ],
      "timeoutMs": 10000,
      "trigger": "work-reporting:failure",
      "matcher": "Bash|bash|exec|exec_command|local_shell|Shell|shell|shell_command",
      "handler": "reporting:work-reporting-hook"
    }
  ]
}
