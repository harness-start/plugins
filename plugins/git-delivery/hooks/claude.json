{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent|agent|Bash|bash|exec|exec_command|local_shell|Shell|shell|shell_command|spawn_agent|Task|task|TaskCreate",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/hooks/git-delivery-hook-pre-tool.mjs\"",
            "timeout": 20000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/hooks/git-delivery-hook-user-prompt.mjs\"",
            "timeout": 10000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|ApplyPatch|Edit|MultiEdit|NotebookEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/hooks/git-delivery-hook-post-tool.mjs\"",
            "timeout": 15000
          }
        ]
      }
    ]
  }
}
