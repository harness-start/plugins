{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent|agent|apply_patch|ApplyPatch|Bash|bash|create_file|Edit|edit|exec|exec_command|local_shell|MultiEdit|NotebookEdit|search_replace|Shell|shell|shell_command|spawn_agent|Task|task|TaskCreate|Write|write",
        "hooks": [
          {
            "type": "command",
            "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"git-delivery:pre\" node \"${PLUGIN_ROOT}/dist/hooks/git-delivery-hook-pre-tool.mjs\"",
            "statusMessage": "Checking Git command and repository state",
            "timeout": 20000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"git-delivery:prompt\" node \"${PLUGIN_ROOT}/dist/hooks/git-delivery-hook-user-prompt.mjs\"",
            "statusMessage": "Recording explicit worktree create requests",
            "timeout": 10000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|ApplyPatch|Edit|MultiEdit|NotebookEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"git-delivery:post\" node \"${PLUGIN_ROOT}/dist/hooks/git-delivery-hook-post-tool.mjs\"",
            "statusMessage": "Checking final files for merge conflict markers",
            "timeout": 15000
          }
        ]
      }
    ]
  }
}
