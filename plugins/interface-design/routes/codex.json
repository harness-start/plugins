{
  "SessionStart": [
    {
      "args": [
        "session"
      ],
      "timeoutMs": 10000,
      "trigger": "interface-craft:session-start",
      "handler": "craft:interface-craft"
    }
  ],
  "PostToolUse": [
    {
      "args": [
        "post"
      ],
      "timeoutMs": 10000,
      "trigger": "interface-craft:post",
      "matcher": "apply_patch|ApplyPatch|Edit|MultiEdit|NotebookEdit|Write|create_file|search_replace",
      "handler": "craft:interface-craft"
    }
  ],
  "Stop": [
    {
      "args": [
        "stop"
      ],
      "timeoutMs": 10000,
      "trigger": "interface-craft:stop",
      "handler": "craft:interface-craft"
    }
  ]
}
