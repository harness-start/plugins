{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "apply_patch|ApplyPatch|Bash|bash|Edit|exec|exec_command|local_shell|MultiEdit|NotebookEdit|Shell|shell|shell_command|Write|create_file|search_replace",
        "hooks": [
          {
            "type": "command",
            "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"spec-driven-development:pre\" node \"${PLUGIN_ROOT}/dist/hooks/spec-driven-development-hook.mjs\" pre codex",
            "statusMessage": "Checking SDD artifact prerequisites",
            "timeout": 10000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|ApplyPatch|Bash|bash|Edit|exec|exec_command|local_shell|MultiEdit|NotebookEdit|Shell|shell|shell_command|Write|create_file|search_replace",
        "hooks": [
          {
            "type": "command",
            "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"spec-driven-development:post\" node \"${PLUGIN_ROOT}/dist/hooks/spec-driven-development-hook.mjs\" post codex",
            "statusMessage": "Checking SDD artifact consistency",
            "timeout": 10000
          }
        ]
      }
    ]
  }
}
