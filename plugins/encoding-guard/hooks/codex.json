{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "apply_patch|ApplyPatch|Bash|bash|Edit|exec|exec_command|local_shell|MultiEdit|NotebookEdit|Shell|shell|shell_command|Write",
        "hooks": [
          {
            "type": "command",
            "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"encoding-guard:post-tool-use\" node \"${PLUGIN_ROOT}/dist/hooks/encoding-guard.mjs\"",
            "statusMessage": "Checking file encoding",
            "timeout": 10000
          }
        ]
      }
    ]
  }
}
