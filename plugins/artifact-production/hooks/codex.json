{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"artifact-production:SessionStart\" node \"${PLUGIN_ROOT}/dist/hooks/dispatcher.mjs\" codex SessionStart",
            "statusMessage": "artifact-production: applying always-on governance",
            "timeout": 120000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "apply_patch|ApplyPatch|Bash|bash|Edit|exec|exec_command|local_shell|MultiEdit|NotebookEdit|Shell|shell|shell_command|Write|create_file|search_replace",
        "hooks": [
          {
            "type": "command",
            "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"artifact-production:PreToolUse\" node \"${PLUGIN_ROOT}/dist/hooks/dispatcher.mjs\" codex PreToolUse",
            "statusMessage": "artifact-production: applying always-on governance",
            "timeout": 120000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|ApplyPatch|Bash|bash|Edit|exec|exec_command|local_shell|MultiEdit|NotebookEdit|Shell|shell|shell_command|Write|create_file|search_replace",
        "hooks": [
          {
            "type": "command",
            "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"artifact-production:PostToolUse\" node \"${PLUGIN_ROOT}/dist/hooks/dispatcher.mjs\" codex PostToolUse",
            "statusMessage": "artifact-production: applying always-on governance",
            "timeout": 120000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"artifact-production:Stop\" node \"${PLUGIN_ROOT}/dist/hooks/dispatcher.mjs\" codex Stop",
            "statusMessage": "artifact-production: applying always-on governance",
            "timeout": 120000
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash|bash|exec|exec_command|local_shell|Shell|shell|shell_command",
        "hooks": [
          {
            "type": "command",
            "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"artifact-production:PostToolUseFailure\" node \"${PLUGIN_ROOT}/dist/hooks/dispatcher.mjs\" codex PostToolUseFailure",
            "statusMessage": "artifact-production: applying always-on governance",
            "timeout": 120000
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"artifact-production:SubagentStop\" node \"${PLUGIN_ROOT}/dist/hooks/dispatcher.mjs\" codex SubagentStop",
            "statusMessage": "artifact-production: applying always-on governance",
            "timeout": 120000
          }
        ]
      }
    ]
  }
}
