{
  "hooks": {
    "SessionStart": [{
      "hooks": [{
        "type": "command",
        "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"behavioral-regression-guard:session\" node \"${PLUGIN_ROOT}/scripts/behavioral-regression-guard.mjs\" session",
        "statusMessage": "Discovering behavioral regression contracts",
        "timeout": 10000
      }]
    }],
    "PreToolUse": [{
      "matcher": "apply_patch|ApplyPatch|Bash|bash|Edit|exec|exec_command|local_shell|MultiEdit|NotebookEdit|Shell|shell|shell_command|Write|create_file|search_replace",
      "hooks": [{
        "type": "command",
        "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"behavioral-regression-guard:pre\" node \"${PLUGIN_ROOT}/scripts/behavioral-regression-guard.mjs\" pre codex",
        "statusMessage": "Checking behavioral proof boundary",
        "timeout": 10000
      }]
    }],
    "PostToolUse": [{
      "matcher": "apply_patch|ApplyPatch|Bash|bash|Edit|exec|exec_command|local_shell|MultiEdit|NotebookEdit|Shell|shell|shell_command|Write|create_file|search_replace",
      "hooks": [{
        "type": "command",
        "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"behavioral-regression-guard:post\" node \"${PLUGIN_ROOT}/scripts/behavioral-regression-guard.mjs\" post codex",
        "statusMessage": "Recording behavioral regression evidence",
        "timeout": 10000
      }]
    }],
    "Stop": [{
      "hooks": [{
        "type": "command",
        "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"behavioral-regression-guard:stop\" node \"${PLUGIN_ROOT}/scripts/behavioral-regression-guard.mjs\" stop",
        "statusMessage": "Validating behavioral regression closure",
        "timeout": 10000
      }]
    }],
    "SubagentStop": [{
      "hooks": [{
        "type": "command",
        "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"behavioral-regression-guard:subagent-stop\" node \"${PLUGIN_ROOT}/scripts/behavioral-regression-guard.mjs\" subagent-stop codex",
        "statusMessage": "Observing advisory behavioral review",
        "timeout": 10000
      }]
    }]
  }
}
