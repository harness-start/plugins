{
  "hooks": {
    "SessionStart": [{
      "hooks": [{
        "type": "command",
        "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/behavioral-regression-guard.mjs\" session",
        "statusMessage": "Discovering behavioral regression contracts",
        "timeout": 10000
      }]
    }],
    "PreToolUse": [{
        "matcher": "Agent|Task|Skill|mcp__.*|apply_patch|ApplyPatch|Bash|bash|Edit|exec|exec_command|Glob|Grep|local_shell|MultiEdit|NotebookEdit|Read|Shell|shell|shell_command|WebFetch|WebSearch|Write|create_file|search_replace",
      "hooks": [{
        "type": "command",
        "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/behavioral-regression-guard.mjs\" pre claude",
        "statusMessage": "Checking behavioral proof boundary",
        "timeout": 10000
      }]
    }, {
      "matcher": "Agent|Task|Skill|mcp__.*|apply_patch|ApplyPatch|Bash|bash|Edit|exec|exec_command|Glob|Grep|local_shell|MultiEdit|NotebookEdit|Read|Shell|shell|shell_command|WebFetch|WebSearch|Write|create_file|search_replace",
      "hooks": [{
        "type": "command",
        "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/behavioral-regression-guard.mjs\" review-pre claude",
        "statusMessage": "Checking independent behavioral review",
        "timeout": 10000
      }]
    }],
    "PostToolUse": [{
      "matcher": "apply_patch|ApplyPatch|Bash|bash|Edit|exec|exec_command|local_shell|MultiEdit|NotebookEdit|Shell|shell|shell_command|Write|create_file|search_replace",
      "hooks": [{
        "type": "command",
        "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/behavioral-regression-guard.mjs\" post claude",
        "statusMessage": "Recording behavioral regression evidence",
        "timeout": 10000
      }]
    }],
    "PostToolUseFailure": [{
      "matcher": "Bash|bash|exec|exec_command|local_shell|Shell|shell|shell_command",
      "hooks": [{
        "type": "command",
        "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/behavioral-regression-guard.mjs\" failure claude",
        "statusMessage": "Recording failing behavioral baseline",
        "timeout": 10000
      }]
    }],
    "Stop": [{
      "hooks": [{
        "type": "command",
        "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/behavioral-regression-guard.mjs\" stop",
        "statusMessage": "Validating behavioral regression closure",
        "timeout": 10000
      }]
    }],
    "SubagentStart": [{
      "hooks": [{
        "type": "command",
        "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/behavioral-regression-guard.mjs\" review-start claude",
        "statusMessage": "Binding independent behavioral reviewer",
        "timeout": 10000
      }]
    }],
    "SubagentStop": [{
      "hooks": [{
        "type": "command",
        "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/behavioral-regression-guard.mjs\" subagent-stop claude",
        "statusMessage": "Recording independent behavioral review",
        "timeout": 10000
      }]
    }]
  }
}
