{
  "hooks": {
    "PreToolUse": [{
      "matcher": "apply_patch|ApplyPatch|Bash|bash|Edit|exec|exec_command|local_shell|MultiEdit|NotebookEdit|Shell|shell|shell_command|Write",
      "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/scripts/mobile-hook-pre-tool.mjs\"", "statusMessage": "mobile-guards: lockfiles", "timeout": 10000 }]
    }],
    "PostToolUse": [{
      "matcher": "apply_patch|ApplyPatch|Bash|bash|Edit|exec|exec_command|local_shell|MultiEdit|NotebookEdit|Shell|shell|shell_command|Write",
      "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/scripts/mobile-hook-post-tool.mjs\"", "statusMessage": "mobile-guards: source checks", "timeout": 30000 }]
    }],
    "UserPromptSubmit": [{
      "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/scripts/mobile-hook-user-prompt.mjs\"", "statusMessage": "mobile-guards: environment", "timeout": 15000 }]
    }]
  }
}
