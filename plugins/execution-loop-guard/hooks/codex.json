{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|bash|exec|exec_command|local_shell|Shell|shell|shell_command|wait|wait_agent|list_agents|write_stdin|functions.wait|functions.write_stdin|collaboration.wait_agent|collaboration.list_agents",
        "hooks": [
          {
            "type": "command",
            "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"execution-loop-guard:pre\" node \"${PLUGIN_ROOT}/dist/hooks/execution-loop-guard.mjs\" pre",
            "statusMessage": "Checking execution loop budget",
            "timeout": 10000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|ApplyPatch|Bash|bash|Edit|exec|exec_command|local_shell|MultiEdit|NotebookEdit|Shell|shell|shell_command|Write",
        "hooks": [
          {
            "type": "command",
            "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"execution-loop-guard:post\" node \"${PLUGIN_ROOT}/dist/hooks/execution-loop-guard.mjs\" post",
            "statusMessage": "Recording execution progress",
            "timeout": 10000
          }
        ]
      }
    ]
  }
}
