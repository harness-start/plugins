{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"verification-provenance-guard:session\" node \"${PLUGIN_ROOT}/scripts/verification-provenance-guard.mjs\" session",
            "statusMessage": "Loading evidence reporting contract",
            "timeout": 10000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"verification-provenance-guard:prompt\" node \"${PLUGIN_ROOT}/scripts/verification-provenance-guard.mjs\" prompt",
            "statusMessage": "Starting a fresh verification epoch",
            "timeout": 10000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|ApplyPatch|Bash|bash|Edit|exec|exec_command|local_shell|MultiEdit|NotebookEdit|Shell|shell|shell_command|Write|create_file|search_replace",
        "hooks": [
          {
            "type": "command",
            "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"verification-provenance-guard:post\" node \"${PLUGIN_ROOT}/scripts/verification-provenance-guard.mjs\" post",
            "statusMessage": "Recording verification provenance",
            "timeout": 10000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"verification-provenance-guard:stop\" node \"${PLUGIN_ROOT}/scripts/verification-provenance-guard.mjs\" stop",
            "statusMessage": "Validating completion evidence",
            "timeout": 10000
          }
        ]
      }
    ]
  }
}
