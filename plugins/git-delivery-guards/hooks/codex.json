{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|bash|exec|exec_command|local_shell|Shell|shell|shell_command",
        "hooks": [
          {
            "type": "command",
            "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"git-delivery-guards:pre\" node \"${PLUGIN_ROOT}/scripts/git-delivery-hook-pre-tool.mjs\"",
            "statusMessage": "Checking Git command and repository state",
            "timeout": 20000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|ApplyPatch|Edit|MultiEdit|NotebookEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"git-delivery-guards:post\" node \"${PLUGIN_ROOT}/scripts/git-delivery-hook-post-tool.mjs\"",
            "statusMessage": "Checking final files for merge conflict markers",
            "timeout": 15000
          }
        ]
      }
    ]
  }
}
