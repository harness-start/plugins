{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|bash|exec|exec_command|local_shell|Shell|shell|shell_command",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/git-delivery-hook-pre-tool.mjs\"",
            "statusMessage": "git-delivery-guards: command and repository state",
            "timeout": 20000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|ApplyPatch|Bash|bash|Edit|exec|exec_command|local_shell|MultiEdit|NotebookEdit|Shell|shell|shell_command|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/git-delivery-hook-post-tool.mjs\"",
            "statusMessage": "git-delivery-guards: conflict and CI checks",
            "timeout": 15000
          }
        ]
      }
    ]
  }
}
