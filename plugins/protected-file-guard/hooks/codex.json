{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "apply_patch|ApplyPatch|Bash|bash|Edit|exec|exec_command|local_shell|MultiEdit|NotebookEdit|Shell|shell|shell_command|Write|create_file|search_replace",
        "hooks": [
          {
            "type": "command",
            "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"protected-file-guard:pre-tool-use\" node \"${PLUGIN_ROOT}/dist/hooks/protected-file-guard.mjs\"",
            "statusMessage": "Checking protected files",
            "timeout": 10000
          }
        ]
      }
    ]
  }
}
