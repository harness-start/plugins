{
  "hooks": {
    "SessionStart": [{
      "hooks": [{
        "type": "command",
        "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/hooks/training-program-design.mjs\" session",
        "statusMessage": "Discovering training projects",
        "timeout": 10000
      }]
    }],
    "PreToolUse": [{
      "matcher": "apply_patch|ApplyPatch|Bash|bash|Edit|exec|exec_command|local_shell|MultiEdit|NotebookEdit|Shell|shell|shell_command|Write|create_file|search_replace",
      "hooks": [{
        "type": "command",
        "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/hooks/training-program-design.mjs\" pre",
        "statusMessage": "Checking training writer boundaries",
        "timeout": 10000
      }]
    }],
    "PostToolUse": [{
      "matcher": "apply_patch|ApplyPatch|Bash|bash|Edit|exec|exec_command|local_shell|MultiEdit|NotebookEdit|Shell|shell|shell_command|Write|create_file|search_replace",
      "hooks": [{
        "type": "command",
        "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/hooks/training-program-design.mjs\" post",
        "statusMessage": "Revalidating training stage evidence",
        "timeout": 10000
      }]
    }],
    "PostToolUseFailure": [{
      "matcher": "Bash|bash|exec|exec_command|local_shell|Shell|shell|shell_command",
      "hooks": [{
        "type": "command",
        "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/hooks/training-program-design.mjs\" failure",
        "statusMessage": "Checking partial training mutations",
        "timeout": 10000
      }]
    }],
    "Stop": [{
      "hooks": [{
        "type": "command",
        "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/hooks/training-program-design.mjs\" stop",
        "statusMessage": "Validating training delivery closure",
        "timeout": 10000
      }]
    }],
    "SubagentStop": [{
      "hooks": [{
        "type": "command",
        "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/hooks/training-program-design.mjs\" subagent-stop",
        "statusMessage": "Reporting training review gaps",
        "timeout": 10000
      }]
    }]
  }
}
