{
  "hooks": {
    "SessionStart": [{
      "hooks": [{
        "type": "command",
        "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"training-program-design:session\" node \"${PLUGIN_ROOT}/dist/hooks/training-program-design.mjs\" session",
        "statusMessage": "Discovering training projects",
        "timeout": 10000
      }]
    }],
    "PreToolUse": [{
      "matcher": "apply_patch|ApplyPatch|Bash|bash|Edit|exec|exec_command|local_shell|MultiEdit|NotebookEdit|Shell|shell|shell_command|Write|create_file|search_replace",
      "hooks": [{
        "type": "command",
        "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"training-program-design:pre\" node \"${PLUGIN_ROOT}/dist/hooks/training-program-design.mjs\" pre",
        "statusMessage": "Checking training writer boundaries",
        "timeout": 10000
      }]
    }],
    "PostToolUse": [{
      "matcher": "apply_patch|ApplyPatch|Bash|bash|Edit|exec|exec_command|local_shell|MultiEdit|NotebookEdit|Shell|shell|shell_command|Write|create_file|search_replace",
      "hooks": [{
        "type": "command",
        "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"training-program-design:post\" node \"${PLUGIN_ROOT}/dist/hooks/training-program-design.mjs\" post",
        "statusMessage": "Revalidating training stage evidence",
        "timeout": 10000
      }]
    }],
    "Stop": [{
      "hooks": [{
        "type": "command",
        "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"training-program-design:stop\" node \"${PLUGIN_ROOT}/dist/hooks/training-program-design.mjs\" stop",
        "statusMessage": "Validating training delivery closure",
        "timeout": 10000
      }]
    }],
    "SubagentStop": [{
      "hooks": [{
        "type": "command",
        "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"training-program-design:subagent-stop\" node \"${PLUGIN_ROOT}/dist/hooks/training-program-design.mjs\" subagent-stop",
        "statusMessage": "Reporting training review gaps",
        "timeout": 10000
      }]
    }]
  }
}
