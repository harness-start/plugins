{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "apply_patch|ApplyPatch|Bash|bash|Edit|exec|exec_command|local_shell|MultiEdit|NotebookEdit|Shell|shell|shell_command|Write",
        "hooks": [
          {
            "type": "command",
            "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"code-quality-guard:post\" node \"${PLUGIN_ROOT}/scripts/code-quality-post.mjs\"",
            "statusMessage": "Running source quality checks",
            "timeout": 60000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"code-quality-guard:stop\" node \"${PLUGIN_ROOT}/scripts/code-quality-stop.mjs\"",
            "statusMessage": "Running PHPStan batch checks",
            "timeout": 60000
          }
        ]
      }
    ]
  }
}
