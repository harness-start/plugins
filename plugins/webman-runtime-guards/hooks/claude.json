{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|ApplyPatch|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/webman-hook-pre-tool.mjs\"",
            "statusMessage": "webman-runtime-guards: protected paths",
            "timeout": 15000
          }
        ]
      }
    ]
  }
}
