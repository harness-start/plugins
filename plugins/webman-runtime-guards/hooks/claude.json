{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "apply_patch|ApplyPatch|Bash|bash|Edit|exec|exec_command|local_shell|MultiEdit|NotebookEdit|Shell|shell|shell_command|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/webman-hook-pre-tool.mjs\"",
            "statusMessage": "webman-runtime-guards: protected paths",
            "timeout": 15000
          }
        ]
      }
    ]
  }
}
