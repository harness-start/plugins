{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"interface-craft:session-start\" HARNESS_HOST=codex node \"${PLUGIN_ROOT}/dist/hooks/interface-craft.mjs\" session",
            "statusMessage": "Loading interface craft routes",
            "timeout": 10000,
            "additionalContextLimit": 1800
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|ApplyPatch|Edit|MultiEdit|NotebookEdit|Write|create_file|search_replace",
        "hooks": [
          {
            "type": "command",
            "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"interface-craft:post\" HARNESS_HOST=codex node \"${PLUGIN_ROOT}/dist/hooks/interface-craft.mjs\" post",
            "statusMessage": "Checking UI craft on edited files",
            "timeout": 10000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"interface-craft:stop\" HARNESS_HOST=codex node \"${PLUGIN_ROOT}/dist/hooks/interface-craft.mjs\" stop",
            "statusMessage": "Rechecking UI files from this session",
            "timeout": 10000
          }
        ]
      }
    ]
  }
}
