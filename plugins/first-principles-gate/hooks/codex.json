{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"first-principles-gate:prompt\" node \"${PLUGIN_ROOT}/scripts/first-principles-gate.mjs\" prompt",
            "statusMessage": "First-principles entry/classify",
            "timeout": 10000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Grep|apply_patch|ApplyPatch|Bash|bash|Edit|exec|exec_command|local_shell|MultiEdit|NotebookEdit|Shell|shell|shell_command|Write|create_file|search_replace",
        "hooks": [
          {
            "type": "command",
            "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"first-principles-gate:pre\" node \"${PLUGIN_ROOT}/scripts/first-principles-gate.mjs\" pre",
            "statusMessage": "First-principles write-block",
            "timeout": 10000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|ApplyPatch|Edit|MultiEdit|NotebookEdit|Write|create_file|search_replace",
        "hooks": [
          {
            "type": "command",
            "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"first-principles-gate:post\" node \"${PLUGIN_ROOT}/scripts/first-principles-gate.mjs\" post",
            "statusMessage": "First-principles ledger revision",
            "timeout": 10000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"first-principles-gate:stop\" node \"${PLUGIN_ROOT}/scripts/first-principles-gate.mjs\" stop",
            "statusMessage": "First-principles ledger gate",
            "timeout": 10000
          }
        ]
      }
    ]
  }
}
