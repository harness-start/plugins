{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"reasoning-discipline-guard:session\" node \"${PLUGIN_ROOT}/scripts/reasoning-discipline-guard.mjs\" session",
            "statusMessage": "Discovering reasoning workflows",
            "timeout": 10000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|ApplyPatch|Edit|MultiEdit|NotebookEdit|Write|create_file|search_replace",
        "hooks": [
          {
            "type": "command",
            "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"reasoning-discipline-guard:post\" node \"${PLUGIN_ROOT}/scripts/reasoning-discipline-guard.mjs\" post",
            "statusMessage": "Validating reasoning stage",
            "timeout": 10000
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "apply_patch|ApplyPatch|Edit|MultiEdit|NotebookEdit|Write|create_file|search_replace",
        "hooks": [
          {
            "type": "command",
            "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"reasoning-discipline-guard:failure\" node \"${PLUGIN_ROOT}/scripts/reasoning-discipline-guard.mjs\" failure",
            "statusMessage": "Checking failed reasoning write",
            "timeout": 10000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"reasoning-discipline-guard:stop\" node \"${PLUGIN_ROOT}/scripts/reasoning-discipline-guard.mjs\" stop",
            "statusMessage": "Checking reasoning conclusion",
            "timeout": 10000
          }
        ]
      }
    ]
  }
}
