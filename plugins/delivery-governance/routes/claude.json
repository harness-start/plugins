{
  "PreToolUse": [
    {
      "timeoutMs": 20000,
      "matcher": "Agent|agent|apply_patch|ApplyPatch|Bash|bash|create_file|Edit|edit|exec|exec_command|local_shell|MultiEdit|NotebookEdit|search_replace|Shell|shell|shell_command|spawn_agent|Task|task|TaskCreate|Write|write",
      "handler": "git:git-delivery-hook-pre-tool"
    },
    {
      "args": [
        "pre"
      ],
      "timeoutMs": 10000,
      "matcher": "Bash|bash|exec|exec_command|local_shell|Shell|shell|shell_command",
      "handler": "ci:ci-gated-delivery"
    },
    {
      "timeoutMs": 10000,
      "matcher": "Bash|bash|exec|exec_command|local_shell|Shell|shell|shell_command",
      "handler": "history:repository-history-migration"
    }
  ],
  "UserPromptSubmit": [
    {
      "timeoutMs": 10000,
      "handler": "git:git-delivery-hook-user-prompt"
    }
  ],
  "PostToolUse": [
    {
      "timeoutMs": 15000,
      "matcher": "apply_patch|ApplyPatch|Edit|MultiEdit|NotebookEdit|Write",
      "handler": "git:git-delivery-hook-post-tool"
    }
  ],
  "Stop": [
    {
      "timeoutMs": 10000,
      "trigger": "git-delivery:stop",
      "handler": "git:git-delivery-hook-stop"
    }
  ]
}
