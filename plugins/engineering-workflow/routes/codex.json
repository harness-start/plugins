{
  "SessionStart": [
    {
      "module": "debugging",
      "script": "dist/hooks/software-debugging.mjs",
      "args": [
        "session"
      ],
      "timeoutMs": 10000,
      "trigger": "software-debugging:session"
    },
    {
      "module": "testing",
      "script": "dist/hooks/test-driven-development.mjs",
      "args": [
        "session-start",
        "codex"
      ],
      "timeoutMs": 10000,
      "trigger": "test-driven-development:session-start"
    }
  ],
  "PreToolUse": [
    {
      "module": "debugging",
      "script": "dist/hooks/software-debugging.mjs",
      "args": [
        "pre"
      ],
      "timeoutMs": 10000,
      "trigger": "software-debugging:pre",
      "matcher": "Read|Grep|apply_patch|ApplyPatch|Bash|bash|Edit|exec|exec_command|local_shell|MultiEdit|NotebookEdit|Shell|shell|shell_command|Write|create_file|search_replace"
    },
    {
