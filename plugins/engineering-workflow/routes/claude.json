{
  "SessionStart": [
    {
      "handler": "debugging",
      "args": [
        "session"
      ],
      "timeoutMs": 10000
    },
    {
      "handler": "testing",
      "args": [
        "session-start",
        "claude"
      ],
      "timeoutMs": 10000
    }
  ],
  "PreToolUse": [
    {
      "handler": "debugging",
      "args": [
        "pre"
      ],
      "timeoutMs": 10000,
      "matcher": "Read|Grep|apply_patch|ApplyPatch|Bash|bash|Edit|exec|exec_command|local_shell|MultiEdit|NotebookEdit|Shell|shell|shell_command|Write|create_file|search_replace"
    },
    {
      "handler": "specification",
      "args": [
        "pre",
        "claude"
      ],
      "timeoutMs": 10000,
      "matcher": "apply_patch|ApplyPatch|Bash|bash|Edit|exec|exec_command|local_shell|MultiEdit|NotebookEdit|Shell|shell|shell_command|Write|create_file|search_replace"
    },
    {
      "handler": "testing",
      "args": [
        "pre",
        "claude"
      ],
      "timeoutMs": 10000,
      "matcher": "apply_patch|ApplyPatch|Bash|bash|Edit|exec|exec_command|local_shell|MultiEdit|NotebookEdit|Shell|shell|shell_command|Write|create_file|search_replace"
    }
  ],
  "PostToolUse": [
    {
      "handler": "debugging",
      "args": [
        "post"
      ],
      "timeoutMs": 10000,
      "matcher": "apply_patch|ApplyPatch|Bash|bash|Edit|exec|exec_command|local_shell|MultiEdit|NotebookEdit|Shell|shell|shell_command|Write|create_file|search_replace"
    },
    {
      "handler": "specification",
      "args": [
        "post",
        "claude"
      ],
      "timeoutMs": 10000,
      "matcher": "apply_patch|ApplyPatch|Bash|bash|Edit|exec|exec_command|local_shell|MultiEdit|NotebookEdit|Shell|shell|shell_command|Write|create_file|search_replace"
    }
  ],
  "PostToolUseFailure": [
    {
      "handler": "debugging",
      "args": [
        "failure"
      ],
      "timeoutMs": 10000,
      "matcher": "Bash|bash|exec|exec_command|local_shell|Shell|shell|shell_command"
    }
  ],
  "Stop": [
    {
      "handler": "debugging",
      "args": [
        "stop"
      ],
      "timeoutMs": 10000
    }
  ]
}
