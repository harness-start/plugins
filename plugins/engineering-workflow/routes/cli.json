{
  "debug": {
    "*": {
      "handler": "debugging",
      "forwardAction": true
    }
  },
  "delegate": {
    "*": {
      "handler": "delegation",
      "forwardAction": true
    }
  },
  "spec": {
    "check": {
      "handler": "specification",
      "args": [
        "validate"
      ]
    }
  }
}
