{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"evidence-based-research:session\" node \"${PLUGIN_ROOT}/dist/hooks/evidence-based-research.mjs\" session",
            "statusMessage": "Loading research evidence contract",
            "timeout": 10000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"evidence-based-research:prompt\" node \"${PLUGIN_ROOT}/dist/hooks/evidence-based-research.mjs\" prompt",
            "statusMessage": "Updating research evidence epoch",
            "timeout": 10000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "apply_patch|ApplyPatch|Bash|bash|Edit|exec|exec_command|local_shell|MultiEdit|NotebookEdit|Shell|shell|shell_command|Write|create_file|search_replace|mcp__.*research_provenance__.*",
        "hooks": [
          {
            "type": "command",
            "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"evidence-based-research:pre\" node \"${PLUGIN_ROOT}/dist/hooks/evidence-based-research.mjs\" pre",
            "statusMessage": "Enforcing research evidence path",
            "timeout": 10000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|ApplyPatch|Bash|bash|Edit|exec|exec_command|local_shell|MultiEdit|NotebookEdit|Shell|shell|shell_command|Write|create_file|search_replace|mcp__.*research_provenance__.*",
        "hooks": [
          {
            "type": "command",
            "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"evidence-based-research:post\" node \"${PLUGIN_ROOT}/dist/hooks/evidence-based-research.mjs\" post",
            "statusMessage": "Recording research provenance",
            "timeout": 10000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"evidence-based-research:stop\" node \"${PLUGIN_ROOT}/dist/hooks/evidence-based-research.mjs\" stop",
            "statusMessage": "Validating research evidence seal",
            "timeout": 10000
          }
        ]
      }
    ]
  }
}
