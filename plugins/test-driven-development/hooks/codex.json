{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"test-driven-development:session-start\" node \"${PLUGIN_ROOT}/dist/hooks/test-driven-development.mjs\" session-start codex",
            "statusMessage": "Loading test-first file-order reminder",
            "timeout": 10000,
            "additionalContextLimit": 1200
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "apply_patch|ApplyPatch|Bash|bash|Edit|exec|exec_command|local_shell|MultiEdit|NotebookEdit|Shell|shell|shell_command|Write|create_file|search_replace",
        "hooks": [
          {
            "type": "command",
            "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"test-driven-development:pre\" node \"${PLUGIN_ROOT}/dist/hooks/test-driven-development.mjs\" pre codex",
            "statusMessage": "Checking test-first file order",
            "timeout": 10000
          }
        ]
      }
    ]
  }
}
