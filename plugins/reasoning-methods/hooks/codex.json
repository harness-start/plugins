            "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"reasoning-methods:session-start\" HARNESS_HOST=codex node \"${PLUGIN_ROOT}/dist/hooks/reasoning-methods.mjs\"",
