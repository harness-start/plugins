{
  "UserPromptSubmit": [
    {
      "args": [
        "prompt"
      ],
      "timeoutMs": 10000,
      "trigger": "intent-discovery:first-turn",
      "handler": "intent:intent-discovery"
    },
    {
      "args": [
        "user-prompt"
      ],
      "timeoutMs": 10000,
      "trigger": "engineering-practice:user-prompt",
      "handler": "practice:engineering-practice"
    },
    {
      "timeoutMs": 10000,
      "trigger": "language-output:user-prompt-submit",
      "handler": "language:language-output-hook-user-prompt"
    }
  ],
  "SessionStart": [
    {
      "matcher": "startup|resume|clear",
      "timeoutMs": 10000,
      "trigger": "reasoning-methods:session-start",
      "handler": "reasoning:reasoning-methods"
    },
    {
      "matcher": "startup|resume|clear",
      "args": [
        "session-start"
      ],
      "timeoutMs": 10000,
      "trigger": "engineering-practice:session-start",
      "handler": "practice:engineering-practice"
    },
    {
      "matcher": "startup|resume|clear|compact",
      "timeoutMs": 10000,
      "trigger": "language-output:session-start",
      "handler": "language:language-output-hook-session-start"
    }
  ],
  "PreToolUse": [
    {
      "args": [
        "pre"
      ],
      "timeoutMs": 10000,
      "trigger": "execution-discipline:pre",
      "matcher": "Bash|bash|exec|exec_command|local_shell|Shell|shell|shell_command|wait|wait_agent|list_agents|write_stdin|functions.wait|functions.write_stdin|collaboration.wait_agent|collaboration.list_agents",
      "handler": "discipline:execution-discipline"
    }
  ],
  "PostToolUse": [
    {
      "args": [
        "post"
      ],
      "timeoutMs": 10000,
      "trigger": "execution-discipline:post",
      "matcher": "apply_patch|ApplyPatch|Bash|bash|Edit|exec|exec_command|local_shell|MultiEdit|NotebookEdit|Shell|shell|shell_command|Write",
      "handler": "discipline:execution-discipline"
    },
    {
      "timeoutMs": 10000,
      "trigger": "language-output:post-tool-use",
      "matcher": "Bash|Write|Edit|MultiEdit|apply_patch",
      "handler": "language:language-output-hook-post-tool"
    }
  ],
  "Stop": [
    {
      "timeoutMs": 10000,
      "trigger": "language-output:stop",
      "handler": "language:language-output-hook-stop"
    }
  ],
  "SubagentStop": [
    {
      "timeoutMs": 10000,
      "trigger": "language-output:subagent-stop",
      "handler": "language:language-output-hook-stop"
    }
  ]
}
