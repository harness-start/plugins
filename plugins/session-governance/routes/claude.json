{
  "UserPromptSubmit": [
    {
      "args": [
        "prompt"
      ],
      "timeoutMs": 10000,
      "handler": "intent:intent-discovery"
    },
    {
      "args": [
        "user-prompt"
      ],
      "timeoutMs": 10000,
      "handler": "practice:engineering-practice"
    },
    {
      "timeoutMs": 10000,
      "handler": "language:language-output-hook-user-prompt"
    }
  ],
  "SessionStart": [
    {
      "matcher": "startup|resume|clear",
      "timeoutMs": 10000,
      "handler": "reasoning:reasoning-methods"
    },
    {
      "matcher": "startup|resume|clear",
      "args": [
        "session-start"
      ],
      "timeoutMs": 10000,
      "handler": "practice:engineering-practice"
    },
    {
      "matcher": "startup|resume|clear|compact",
      "timeoutMs": 10000,
      "handler": "language:language-output-hook-session-start"
    }
  ],
  "PreToolUse": [
    {
      "args": [
        "pre"
      ],
      "timeoutMs": 10000,
      "matcher": "Bash|bash|exec|exec_command|local_shell|Shell|shell|shell_command",
      "handler": "discipline:execution-discipline"
    }
  ],
  "PostToolUse": [
    {
      "args": [
        "post"
      ],
      "timeoutMs": 10000,
      "matcher": "apply_patch|ApplyPatch|Bash|bash|Edit|exec|exec_command|local_shell|MultiEdit|NotebookEdit|Shell|shell|shell_command|Write",
      "handler": "discipline:execution-discipline"
    },
    {
      "timeoutMs": 10000,
      "matcher": "Bash|Write|Edit|MultiEdit|apply_patch",
      "handler": "language:language-output-hook-post-tool"
    }
  ],
  "PostToolUseFailure": [
    {
      "args": [
        "failure"
      ],
      "timeoutMs": 10000,
      "matcher": "Bash|bash|exec|exec_command|local_shell|Shell|shell|shell_command",
      "handler": "discipline:execution-discipline"
    }
  ],
  "Stop": [
    {
      "timeoutMs": 10000,
      "handler": "language:language-output-hook-stop"
    }
  ],
  "SubagentStop": [
    {
      "timeoutMs": 10000,
      "handler": "language:language-output-hook-stop"
    }
  ]
}
