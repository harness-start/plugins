{
  "UserPromptSubmit": [
    {
      "module": "intent",
      "script": "dist/hooks/intent-discovery.mjs",
      "args": [
        "prompt"
      ],
      "timeoutMs": 10000
    },
    {
      "module": "practice",
      "script": "dist/hooks/engineering-practice.mjs",
      "args": [
        "user-prompt"
      ],
      "timeoutMs": 10000
    },
    {
      "module": "language",
      "script": "dist/hooks/language-output-hook-user-prompt.mjs",
      "timeoutMs": 10000
    }
  ],
  "SessionStart": [
    {
      "module": "reasoning",
      "script": "dist/hooks/reasoning-methods.mjs",
      "timeoutMs": 10000
    },
    {
      "module": "practice",
      "script": "dist/hooks/engineering-practice.mjs",
      "args": [
        "session-start"
      ],
      "timeoutMs": 10000
    },
    {
      "module": "language",
      "script": "dist/hooks/language-output-hook-session-start.mjs",
      "timeoutMs": 10000
    }
  ],
  "PreToolUse": [
    {
      "module": "discipline",
      "script": "dist/hooks/execution-discipline.mjs",
      "args": [
        "pre"
      ],
      "timeoutMs": 10000,
      "matcher": "Bash|bash|exec|exec_command|local_shell|Shell|shell|shell_command"
    }
  ],
  "PostToolUse": [
    {
      "module": "discipline",
      "script": "dist/hooks/execution-discipline.mjs",
      "args": [
        "post"
      ],
      "timeoutMs": 10000,
      "matcher": "apply_patch|ApplyPatch|Bash|bash|Edit|exec|exec_command|local_shell|MultiEdit|NotebookEdit|Shell|shell|shell_command|Write"
    },
    {
      "module": "language",
      "script": "dist/hooks/language-output-hook-post-tool.mjs",
      "timeoutMs": 10000,
      "matcher": "Bash|Write|Edit|MultiEdit|apply_patch"
    }
  ],
  "PostToolUseFailure": [
    {
      "module": "discipline",
      "script": "dist/hooks/execution-discipline.mjs",
      "args": [
        "failure"
      ],
      "timeoutMs": 10000,
      "matcher": "Bash|bash|exec|exec_command|local_shell|Shell|shell|shell_command"
    }
  ],
  "Stop": [
    {
      "module": "language",
      "script": "dist/hooks/language-output-hook-stop.mjs",
      "timeoutMs": 10000
    }
  ],
  "SubagentStop": [
    {
      "module": "language",
      "script": "dist/hooks/language-output-hook-stop.mjs",
      "timeoutMs": 10000
    }
  ]
}
