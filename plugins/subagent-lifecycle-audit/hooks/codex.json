{
  "hooks": {
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"subagent-lifecycle-audit:start\" node \"${PLUGIN_ROOT}/scripts/subagent-lifecycle-audit.mjs\" start",
            "statusMessage": "Recording subagent lifecycle start",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"subagent-lifecycle-audit:stop\" node \"${PLUGIN_ROOT}/scripts/subagent-lifecycle-audit.mjs\" stop",
            "statusMessage": "Recording subagent lifecycle stop",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "apply_patch|ApplyPatch|Bash|bash|Edit|exec|exec_command|local_shell|MultiEdit|NotebookEdit|Shell|shell|shell_command|Write",
        "hooks": [
          {
            "type": "command",
            "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"subagent-lifecycle-audit:protect\" node \"${PLUGIN_ROOT}/scripts/subagent-lifecycle-audit.mjs\" protect",
            "statusMessage": "Protecting subagent lifecycle audit trail",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
