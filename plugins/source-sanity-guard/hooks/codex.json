{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "apply_patch|ApplyPatch|Edit|MultiEdit|NotebookEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "AI_EXPERTS_SESSION_ID=\"${AI_EXPERTS_SESSION_ID:-hook}\" AI_EXPERTS_TRIGGER_FROM=\"source-sanity-guard:pre\" node \"${PLUGIN_ROOT}/scripts/source-sanity-guard.mjs\"",
            "statusMessage": "Checking source sanity before write",
            "timeout": 10000
          }
        ]
      }
    ]
  }
}
