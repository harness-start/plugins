{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "apply_patch|ApplyPatch|Edit|MultiEdit|NotebookEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/source-sanity-guard.mjs\" pre",
            "timeout": 10000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|ApplyPatch|Edit|MultiEdit|NotebookEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/source-sanity-guard.mjs\" post",
            "timeout": 10000
          }
        ]
      }
    ]
  }
}
