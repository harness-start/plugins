{
  "name": "@harness-start/plugins",
  "version": "1.0.0",
  "description": "Marketplace id: `harness-start` · Display name: **Harness Start**",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsx scripts/build-plugins.ts",
    "check:dist": "tsx scripts/build-plugins.ts --check",
    "ensure:dist": "tsx scripts/build-plugins.ts --ensure",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --no-error-on-unmatched-pattern core/src core/hooks core/tests .claude/hooks .codex/hooks plugins/*/src plugins/*/tests scripts/*.ts",
    "test": "tsx scripts/run-tests.ts",
    "test:ffmpeg": "tsx --test plugins/video-production/tests/media.test.ts plugins/brand-logo-production/tests/squint.test.ts",
    "verify": "npm run typecheck && npm run lint && npm run check:dist && npm test",
    "bench:swe:check": "benchmarks/swe-bench/run.sh check",
    "bench:swe:gold": "benchmarks/swe-bench/run.sh gold-smoke",
    "bench:swe:stage1": "benchmarks/swe-bench/run.sh stage1"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "20.19.39",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "fast-check": "^4.9.0",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "yaml": "^2.9.0"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.11",
    "fflate": "^0.8.2"
  }
}
